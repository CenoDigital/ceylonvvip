# Copy to .env for local development (`pnpm services:up` starts Postgres and storage).
# Real values live in Coolify and GitHub secrets, never in git.

DATABASE_URI=postgres://ceylonvvip:ceylonvvip@127.0.0.1:54320/ceylonvvip
# 32 or more random characters, for example from: openssl rand -hex 32
PAYLOAD_SECRET=

# S3-compatible media storage: Cloudflare R2 in staging and production, RustFS locally.
# Wired into the Media collection in Sprint 1.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1 # RustFS default; R2 uses "auto"
S3_BUCKET=ceylonvvip-media
S3_ACCESS_KEY_ID=ceylonvvip
S3_SECRET_ACCESS_KEY=ceylonvvip-local
